generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique
  email                 String                 @unique
  mobile                String                 @unique
  passwordHash          String
  role                  UserRole               @default(USER)
  accountStatus         AccountStatus          @default(ACTIVE)
  balance               Float                  @default(0)
  referralCode          String                 @unique
  referrerId            String?
  referralEarnings      Float                  @default(0)
  activePlanId          String?
  registrationDate      DateTime               @default(now())
  lastLogin             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]             @relation("AdminAuditLogs")
  targetAuditLogs       AuditLog[]             @relation("TargetAuditLogs")
  notifications         Notification[]
  passwordResetRequests PasswordResetRequest[]
  paymentRequests       PaymentRequest[]
  referredVerifications ReferralVerification?  @relation("ReferredVerifications")
  referralVerifications ReferralVerification[] @relation("ReferrerVerifications")
  transactions          Transaction[]
  activePlan            UserPlan?              @relation("ActivePlan", fields: [activePlanId], references: [id])
  referrer              User?                  @relation("Referrals", fields: [referrerId], references: [id])
  referrals             User[]                 @relation("Referrals")
  userPlans             UserPlan[]             @relation("UserPlans")
  withdrawalRequests    WithdrawalRequest[]
  supportConversations  SupportConversation[]
  supportMessages       SupportMessage[]       @relation("SupportMessageSender")
}

model Plan {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  products        Int
  durationDays    Int
  investment      Float
  statedReturn    Float
  isActive        Boolean          @default(true)
  isVisible       Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentRequests PaymentRequest[]
  userPlans       UserPlan[]
}

model UserPlan {
  id            String        @id @default(cuid())
  userId        String
  planId        String
  amount        Float
  status        RequestStatus @default(PENDING)
  startDate     DateTime?
  endDate       DateTime?
  activatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  activeForUser User[]        @relation("ActivePlan")
  plan          Plan          @relation(fields: [planId], references: [id])
  user          User          @relation("UserPlans", fields: [userId], references: [id])
}

model PaymentAccount {
  id              String           @id @default(cuid())
  methodName      String
  accountHolder   String
  accountNumber   String
  mobileId        String?
  instructions    String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id               String         @id @default(cuid())
  userId           String
  planId           String
  paymentAccountId String
  amount           Float
  screenshotPath   String
  status           RequestStatus  @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])
  plan             Plan           @relation(fields: [planId], references: [id])
  user             User           @relation(fields: [userId], references: [id])
}

model WithdrawalMethod {
  id          String              @id @default(cuid())
  name        String              @unique
  isActive    Boolean             @default(true)
  minAmount   Float               @default(300)
  maxAmount   Float               @default(100000)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  withdrawals WithdrawalRequest[]
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String
  methodId      String
  accountNumber String
  accountHolder String
  amount        Float
  status        RequestStatus    @default(PENDING)
  adminNote     String?
  txReference   String?
  reviewedBy    String?
  reviewedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  method        WithdrawalMethod @relation(fields: [methodId], references: [id])
  user          User             @relation(fields: [userId], references: [id])
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  type            TransactionType
  amount          Float
  previousBalance Float
  newBalance      Float
  status          TransactionStatus @default(COMPLETED)
  description     String?
  relatedId       String?
  source          String?
  createdAt       DateTime          @default(now())
  user            User              @relation(fields: [userId], references: [id])
}

model PasswordResetRequest {
  id               String        @id @default(cuid())
  userId           String
  status           RequestStatus @default(PENDING)
  verificationCode String?
  codeExpiresAt    DateTime?
  codeUsed         Boolean       @default(false)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])
}

model ReferralVerification {
  id           String    @id @default(cuid())
  referrerId   String
  referredId   String    @unique
  isVerified   Boolean   @default(false)
  rewardPaid   Boolean   @default(false)
  rewardAmount Float     @default(0)
  verifiedBy   String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  referred     User      @relation("ReferredVerifications", fields: [referredId], references: [id])
  referrer     User      @relation("ReferrerVerifications", fields: [referrerId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model SupportConversation {
  id        String              @id @default(cuid())
  userId    String
  subject   String
  status    SupportStatus       @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id])
  messages  SupportMessage[]
}

model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  screenshotPath String?
  senderRole     UserRole
  readByUser     Boolean             @default(false)
  readByAdmin    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation("SupportMessageSender", fields: [senderId], references: [id])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id            String   @id @default(cuid())
  adminId       String
  action        String
  targetUserId  String?
  previousValue String?
  newValue      String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  admin         User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  targetUser    User?    @relation("TargetAuditLogs", fields: [targetUserId], references: [id])
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DEACTIVATED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TransactionType {
  DEPOSIT
  PLAN_ACTIVATION
  PLAN_RETURN
  REFERRAL_REWARD
  WITHDRAWAL
  ADJUSTMENT
  REFUND
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

enum SupportStatus {
  OPEN
  CLOSED
}
