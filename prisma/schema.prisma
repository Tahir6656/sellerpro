generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DEACTIVATED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum TransactionType {
  DEPOSIT
  PLAN_ACTIVATION
  PLAN_RETURN
  REFERRAL_REWARD
  WITHDRAWAL
  ADJUSTMENT
  REFUND
  OTHER
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id               String        @id @default(cuid())
  username         String        @unique
  email            String        @unique
  mobile           String        @unique
  passwordHash     String
  role             UserRole      @default(USER)
  accountStatus    AccountStatus @default(ACTIVE)
  balance          Float         @default(0)
  referralCode     String        @unique
  referrerId       String?
  referrer         User?         @relation("Referrals", fields: [referrerId], references: [id])
  referrals        User[]        @relation("Referrals")
  referralEarnings Float         @default(0)
  activePlanId     String?
  activePlan       UserPlan?     @relation("ActivePlan", fields: [activePlanId], references: [id])
  registrationDate DateTime      @default(now())
  lastLogin        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  userPlans              UserPlan[]              @relation("UserPlans")
  paymentRequests        PaymentRequest[]
  withdrawalRequests     WithdrawalRequest[]
  transactions           Transaction[]
  notifications          Notification[]
  passwordResetRequests  PasswordResetRequest[]
  referralVerifications  ReferralVerification[]  @relation("ReferrerVerifications")
  referredVerifications  ReferralVerification[]  @relation("ReferredVerifications")
  auditLogs              AuditLog[]              @relation("AdminAuditLogs")
  targetAuditLogs        AuditLog[]              @relation("TargetAuditLogs")
}

model Plan {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  products        Int
  durationDays    Int
  investment      Float
  statedReturn    Float
  isActive        Boolean  @default(true)
  isVisible       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userPlans       UserPlan[]
  paymentRequests PaymentRequest[]
}

model UserPlan {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation("UserPlans", fields: [userId], references: [id])
  planId        String
  plan          Plan          @relation(fields: [planId], references: [id])
  amount        Float
  status        RequestStatus @default(PENDING)
  startDate     DateTime?
  endDate       DateTime?
  activatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  activeForUser User[] @relation("ActivePlan")
}

model PaymentAccount {
  id              String   @id @default(cuid())
  methodName      String
  accountHolder   String
  accountNumber   String
  mobileId        String?
  instructions    String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paymentRequests PaymentRequest[]
}

model PaymentRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  planId           String
  plan             Plan          @relation(fields: [planId], references: [id])
  paymentAccountId String
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id])
  amount           Float
  screenshotPath   String
  status           RequestStatus @default(PENDING)
  rejectionReason  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model WithdrawalMethod {
  id          String   @id @default(cuid())
  name        String   @unique
  isActive    Boolean  @default(true)
  minAmount   Float    @default(300)
  maxAmount   Float    @default(100000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  withdrawals WithdrawalRequest[]
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  methodId      String
  method        WithdrawalMethod @relation(fields: [methodId], references: [id])
  accountNumber String
  accountHolder String
  amount        Float
  status        RequestStatus    @default(PENDING)
  adminNote     String?
  txReference   String?
  reviewedBy    String?
  reviewedAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Transaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  amount          Float
  previousBalance Float
  newBalance      Float
  status          TransactionStatus @default(COMPLETED)
  description     String?
  relatedId       String?
  source          String?
  createdAt       DateTime          @default(now())
}

model PasswordResetRequest {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  status          RequestStatus @default(PENDING)
  verificationCode String?
  codeExpiresAt   DateTime?
  codeUsed        Boolean       @default(false)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model ReferralVerification {
  id          String        @id @default(cuid())
  referrerId  String
  referrer    User          @relation("ReferrerVerifications", fields: [referrerId], references: [id])
  referredId  String        @unique
  referred    User          @relation("ReferredVerifications", fields: [referredId], references: [id])
  isVerified  Boolean       @default(false)
  rewardPaid  Boolean       @default(false)
  rewardAmount Float        @default(0)
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AdminAuditLogs", fields: [adminId], references: [id])
  action       String
  targetUserId String?
  targetUser   User?    @relation("TargetAuditLogs", fields: [targetUserId], references: [id])
  previousValue String?
  newValue     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
}
